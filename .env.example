# Copy to .env.local for development. On the server these live in the PM2
# ecosystem file, never in the repo.

# Postgres. Locally you can tunnel the server's database:
#   ssh -i ~/.ssh/contabo_deploy -L 5433:127.0.0.1:5432 root@169.58.42.182
# then point DATABASE_URL at 127.0.0.1:5433
DATABASE_URL=postgres://romeotkoduah:CHANGE_ME@127.0.0.1:5432/romeotkoduah

# Signs the admin session cookie. At least 32 characters.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=CHANGE_ME_AT_LEAST_32_CHARACTERS_LONG

# Salts the stored hash of commenter IP addresses. Changing it resets rate
# limiting history; that is harmless.
IP_SALT=CHANGE_ME

# Rate limiting. Optional — the app fails open if Redis is unreachable.
REDIS_URL=redis://127.0.0.1:6379

# Where uploaded gallery photos are written. Served by nginx at /media.
MEDIA_DIR=./public/media
MEDIA_BASE_URL=/media
